# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=11111111,22222222

# Канал для публикации: @username или числовой ID (-100...).
# Бот должен быть администратором канала с правом публикации сообщений.
CHANNEL_ID=@aitu_hub

# (Необязательно) ID секретного чата модераторов (-100...).
# Если не задан — карточки приходят каждому админу в личку бота.
ADMIN_CHAT_ID=

# Путь к файлу базы SQLite
DB_PATH=bot.db

# Анти-спам: минимальный интервал между объявлениями одного пользователя (секунды)
RATE_LIMIT_SECONDS=600
